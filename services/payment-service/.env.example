PORT=5006
NODE_ENV=development

# PostgreSQL (same Neon DB as other services)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT (must match identity-service JWT_SECRET)
JWT_SECRET=your_jwt_secret_key_change_me

# Razorpay Keys (NEVER expose RAZORPAY_KEY_SECRET to the frontend)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (set this in Razorpay Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Internal service URLs (used for server-to-server calls, not via gateway)
ORDER_SERVICE_URL=http://localhost:5002
NOTIFICATION_SERVICE_URL=http://localhost:5005

# CORS allowed origins
CORS_ORIGIN=http://localhost:5173
