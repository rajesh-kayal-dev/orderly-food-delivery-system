# Orderly Platform Environment Variables Template
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Database Configuration (PostgreSQL / MSSQL / MySQL)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=orderly_db
DB_USER=sa
DB_PASS=your_db_password_here

# Services Base URLs (API Gateway Proxies)
GATEWAY_PORT=8000
BACKEND_URL=http://localhost:5001
ORDER_SERVICE_URL=http://localhost:5002
IDENTITY_SERVICE_URL=http://localhost:5003
RESTAURANT_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
FRONTEND_URL=http://localhost:5173

# Third-Party Integrations
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
