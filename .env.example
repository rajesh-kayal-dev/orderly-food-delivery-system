# Orderly Microservices Environment Template
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_me

# Neon PostgreSQL Connection String (Prisma ORM)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Services Base URLs
GATEWAY_PORT=8000
BACKEND_URL=http://localhost:5001
ORDER_SERVICE_URL=http://localhost:5002
IDENTITY_SERVICE_URL=http://localhost:5003
RESTAURANT_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
FRONTEND_URL=http://localhost:5173

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
